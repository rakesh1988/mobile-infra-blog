---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostPreview from "../components/PostPreview.astro";
import Analytics from "../components/Analytics.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Home">
  <Analytics slot="head" />

  <section class="hero">
    <h1>Rakesh Kashyap</h1>
    <p class="subtitle">
      Director - Chapter Lead Android | Mobile Platforms | Android Architecture | Engineering Productivity | AI SDLC
    </p>
  </section>

  <section class="posts">
    <h2>Latest Posts</h2>
    {posts.length > 0 ? (
      posts.map((post) => <PostPreview post={post} />)
    ) : (
      <p class="empty">No posts yet. Stay tuned!</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: left;
    padding: 1.5rem 0 2rem;
  }

  .hero h1 {
    font-size: 2.2rem;
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 100%;
    margin: 0;
  }

  .posts {
    padding-top: 0;
  }

  .posts h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
  }

  .empty {
    color: var(--color-text-muted);
    text-align: center;
    padding: 3rem 0;
  }
</style>
